# Normalize line endings in the repository to LF; check out as-is on every
# platform (the Windows toolchain handles LF fine). PowerShell scripts keep
# CRLF because Windows PowerShell 5.1 mis-parses some LF-only files.
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary assets
*.ico binary
*.png binary
*.icns binary
*.bin binary
*.wav binary

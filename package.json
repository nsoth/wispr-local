{
  "name": "wispr-local",
  "version": "0.2.3",
  "description": "Local, privacy-first voice-to-text dictation tool powered by Whisper.cpp",
  "author": "nsoth",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nsoth/wispr-local"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --max-warnings 0",
    "fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "test": "cargo test --release --manifest-path src-tauri/Cargo.toml --lib",
    "check": "npm run lint && npm run fmt:check && npm run build && npm run test",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "typescript": "^5",
    "typescript-eslint": "^8.71.0",
    "vite": "^6"
  }
}

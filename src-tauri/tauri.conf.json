{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wispr Local",
  "version": "0.1.0",
  "identifier": "com.wispr-local.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Wispr Local",
        "width": 380,
        "height": 460,
        "resizable": true,
        "visible": false
      },
      {
        "label": "overlay",
        "url": "index.html#overlay",
        "width": 312,
        "height": 52,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#111827",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false,
        "visible": false
      }
    ]
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wispr Local",
  "version": "0.2.3",
  "identifier": "com.wispr-local.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    },
    "windows": [
      {
        "label": "main",
        "title": "Wispr Local",
        "width": 380,
        "height": 560,
        "minWidth": 340,
        "minHeight": 420,
        "resizable": true,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "Wispr Local Overlay",
        "url": "index.html#overlay",
        "width": 312,
        "height": 52,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#111827",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false,
        "visible": false
      }
    ]
  }
}
